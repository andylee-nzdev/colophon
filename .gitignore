# macOS
.DS_Store

# IDEs
.idea/
*.iml
*.iws
*.ipr
.vscode/

# Secrets and local config — env vars only, never committed
.env
.env.*
!.env.example

# Local-only working docs (plans, notes, scratch) — never committed
/local/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node (apps/admin, apps/demo)
node_modules/
.next/
out/
dist/
build/
.turbo/

# Generated by `next build`. Not committed because it imports from .next/types,
# which is ignored above — a fresh clone would fail to typecheck until it is rebuilt.
next-env.d.ts
*.tsbuildinfo

# Java / Maven (apps/api keeps its own .gitignore too)
target/
